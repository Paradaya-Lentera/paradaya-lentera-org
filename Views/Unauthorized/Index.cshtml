@{
    ViewData["Title"] = "Access Denied";
}

@section Styles {
    <link rel="stylesheet" href="~/css/unauthorized.css">
}

<div class="unauthorized-container">
    <div class="unauthorized-icon">🔒</div>
    <h1 class="unauthorized-title">Access Denied</h1>
    <p class="unauthorized-message">
        You need to be logged in to access your reading list and manage your books. 
        Please sign in to continue or create a new account if you don't have one.
    </p>
    <div class="unauthorized-actions">
        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn-primary">
            Sign In
        </a>
        <a asp-controller="Auth" asp-action="Register" class="btn-secondary">
            Create Account
        </a>
        <a asp-controller="Page" asp-action="Index" class="btn-secondary">
            Back to Home
        </a>
    </div>
</div>
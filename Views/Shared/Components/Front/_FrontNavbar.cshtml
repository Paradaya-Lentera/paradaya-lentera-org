<nav class="navbar">
    <div class="navbar-container">
        <!-- Brand Logo -->
        <a asp-controller="Page" asp-action="Index" class="navbar-brand">
            <img src="~/images/lentera-logo.png" alt="Lentera Logo" class="navbar-logo-img">
            <span class="brand-text">Lentera</span>
        </a>

        <!-- Desktop Navigation & Actions -->
        <div class="navbar-collapse" id="navbarCollapse">
            <div class="navbar-menu">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Page" asp-action="ReadingList"
                        class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Page" && ViewContext.RouteData.Values["Action"]?.ToString() == "ReadingList" ? "active" : "")"
                        style="font-weight: 600;">
                        <i class="bi bi-bookmark nav-icon"></i>
                        <span>My Reading List</span>
                    </a>
                }
            </div>
            
            <div class="navbar-actions">
                <!-- Theme Toggle -->
                <button id="themeToggle" class="theme-toggle" aria-label="Switch Theme" type="button">
                    <i class="bi bi-sun theme-icon switch-light"></i>
                    <i class="bi bi-moon theme-icon switch-dark" style="display: none;"></i>
                </button>

                <!-- Auth Section -->
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="auth-buttons">
                        <a asp-controller="Auth" asp-action="Login" class="btn-login">
                            <i class="bi bi-box-arrow-in-right btn-icon"></i>
                            <span>Login</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn-register">
                            <i class="bi bi-person-plus btn-icon"></i>
                            <span>Register</span>
                        </a>
                    </div>
                }
                else
                {
                    <!-- User Dropdown -->
                    <div class="user-dropdown">
                        @{
                            var userName = User.Identity?.Name ?? "User";
                            if (userName.Contains("@"))
                            {
                                userName = userName.Split('@')[0];
                            }
                            userName = userName.Split(' ')[0];
                        }
                        <div class="user-avatar" id="userAvatar" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">
                            <div class="avatar-circle">
                                <i class="bi bi-person"></i>
                            </div>
                            <span class="user-name" style="font-weight: 600; font-size:1.1rem">@userName</span>
                            <i class="bi bi-chevron-down dropdown-arrow"></i>
                        </div>
                        <div class="dropdown-menu" id="userDropdown" role="menu">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item" role="menuitem">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Mobile Hamburger Button -->
        <button class="navbar-toggler" id="navbarToggler" aria-label="Toggle navigation" aria-expanded="false">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
        </button>
    </div>
</nav>

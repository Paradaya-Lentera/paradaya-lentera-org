<nav class="navbar">
    <a asp-controller="Page" asp-action="Index" class="navbar-brand">
        <img src="~/images/lentera-logo.png" alt="Lentera Logo" class="navbar-logo-img">
        Lentera
    </a>
    <div class="navbar-menu">
        <a asp-controller="Page" asp-action="Index"
            class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Page" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Search</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Page" asp-action="ReadingList"
                class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Page" && ViewContext.RouteData.Values["Action"]?.ToString() == "ReadingList" ? "active" : "")">My
                Reading List</a>
        }
    </div>
    <div class="navbar-actions">
        <button id="themeToggle" class="theme-toggle" aria-label="Switch Theme">
            <span class="theme-icon switch-light">☀️</span>
            <span class="theme-icon switch-dark">🌙</span>
        </button>

        <!-- Auth Buttons - Tampilkan jika user belum login -->
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="auth-buttons">
                <a asp-controller="Auth" asp-action="Login" class="btn-login">Login</a>
                <a asp-controller="Auth" asp-action="Register" class="btn-register">Register</a>
            </div>
        }
        else
        {
            <!-- User Dropdown - Tampilkan jika user sudah login -->
            <div class="user-dropdown">
                @{
                    var userName = User.Identity?.Name ?? "User";
                    if (userName.Contains("@"))
                    {
                        userName = userName.Split('@')[0];
                    }
                    userName = userName.Split(' ')[0];
                }
                <div class="user-avatar" id="userAvatar" style="width: auto; padding: 0 15px; border-radius: 30px; gap: 8px;">
                    <span style="font-size: 0.9rem; font-weight: 600;">@userName</span>
                    <span>👤</span>
                </div>
                <div class="dropdown-menu" id="userDropdown">
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</nav>

<script src="~/js/navbar.js"></script>

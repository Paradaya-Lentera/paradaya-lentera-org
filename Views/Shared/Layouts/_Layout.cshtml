<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lentera</title>
    <meta name="description"
        content="Lentera - Temukan dan kelola koleksi buku favorit Anda. Optimized for Offline Usage.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
          onerror="console.warn('Font Awesome CDN failed'); document.body.classList.add('fontawesome-fallback');">
    <link rel="stylesheet" href="~/css/fontawesome-fallback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/lentera.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        @* Front Navbar Component *@
        <partial name="~/Views/Shared/Components/Front/_FrontNavbar.cshtml" />
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @* Front Footer Component *@
    <partial name="~/Views/Shared/Components/Front/_FrontFooter.cshtml" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js" 
            asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
            asp-fallback-test="window.jQuery"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js" 
            asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <!-- Core utilities -->
    <script src="~/js/core/alert.js" asp-append-version="true"></script>
    <script src="~/js/core/db.js" asp-append-version="true"></script>
    <script src="~/js/core/image.js" asp-append-version="true"></script>
    
    <!-- Components -->
    <script src="~/js/components/theme.js" asp-append-version="true"></script>
    <script src="~/js/components/navbar.js" asp-append-version="true"></script>
    <script src="~/js/components/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/components/auth-modal.js" asp-append-version="true"></script>
    
    <!-- Vendor -->
    <script src="~/js/vendor/fontawesome-fallback.js" asp-append-version="true"></script>
    
    @* Hidden form to provide anti-forgery token to JavaScript *@
    <form id="__AjaxAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    
    <script>
        // Get anti-forgery token from hidden form
        try {
            var tokenElement = document.querySelector('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]');
            window.antiForgeryToken = tokenElement ? tokenElement.value : '';
        } catch (e) {
            console.warn('Could not retrieve anti-forgery token:', e);
            window.antiForgeryToken = '';
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registered', reg))
                    .catch(err => console.log('Service Worker registration failed', err));
            });
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lentera</title>
    <meta name="description"
        content="Lentera - Temukan dan kelola koleksi buku favorit Anda. Optimized for Offline Usage.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Use Local FontAwesome as primary (for consistency) -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <!-- CSS-based fallback for critical icons -->
    <link rel="stylesheet" href="~/css/fontawesome-fallback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/lentera.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert/dist/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        @* Front Navbar Component *@
        <partial name="~/Views/Shared/Components/Front/_FrontNavbar.cshtml" />
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @* Front Footer Component *@
    <partial name="~/Views/Shared/Components/Front/_FrontFooter.cshtml" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js" 
            asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
            asp-fallback-test="window.jQuery"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js" 
            asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/@@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    
    <!-- Load SweetAlert2 first -->
    <script src="~/lib/sweetalert/dist/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script>
        // Verify SweetAlert2 is loaded
        if (typeof Swal === 'undefined') {
            console.error('SweetAlert2 failed to load!');
        } else {
            console.log('SweetAlert2 loaded successfully');
        }
    </script>
    
    <!-- Core utilities -->
    <script src="~/js/core/alert.js" asp-append-version="true"></script>
    <script src="~/js/core/bootstrap-notifications.js" asp-append-version="true"></script>
    <script src="~/js/core/db.js" asp-append-version="true"></script>
    <script src="~/js/core/image.js" asp-append-version="true"></script>
    
    <!-- Components -->
    <script src="~/js/components/theme.js" asp-append-version="true"></script>
    <script src="~/js/components/navbar.js" asp-append-version="true"></script>
    <script src="~/js/components/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/components/auth-modal.js" asp-append-version="true"></script>
    
    <!-- Vendor -->
    <script src="~/js/vendor/fontawesome-fallback.js" asp-append-version="true"></script>
    
    @* Hidden form to provide anti-forgery token to JavaScript *@
    <form id="__AjaxAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    
    <script>
        // Get anti-forgery token from hidden form
        try {
            var tokenElement = document.querySelector('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]');
            window.antiForgeryToken = tokenElement ? tokenElement.value : '';
        } catch (e) {
            console.warn('Could not retrieve anti-forgery token:', e);
            window.antiForgeryToken = '';
        }

        // Global notification handler for TempData
        document.addEventListener('DOMContentLoaded', () => {
            // Wait a bit to ensure all scripts are loaded
            setTimeout(() => {
                const messages = {
                    success: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                    error: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                    info: @Html.Raw(Json.Serialize(TempData["InfoMessage"])),
                    warning: @Html.Raw(Json.Serialize(TempData["WarningMessage"]))
                };

                // Use Bootstrap notifications if available, fallback to SweetAlert
                if (typeof window.showBootstrapNotification === 'function') {
                    if (messages.success) window.showSuccessNotification(messages.success);
                    if (messages.error) window.showErrorNotification(messages.error);
                    if (messages.info) window.showInfoNotification(messages.info);
                    if (messages.warning) window.showWarningNotification(messages.warning);
                } else if (typeof window.showAlert === 'function') {
                    if (messages.success) window.showAlert(messages.success, 'success');
                    if (messages.error) window.showAlert(messages.error, 'error');
                    if (messages.info) window.showAlert(messages.info, 'info');
                    if (messages.warning) window.showAlert(messages.warning, 'warning');
                } else {
                    console.warn('No notification system available, falling back to console log');
                    if (messages.success) console.log('Success:', messages.success);
                    if (messages.error) console.log('Error:', messages.error);
                    if (messages.info) console.log('Info:', messages.info);
                    if (messages.warning) console.log('Warning:', messages.warning);
                }
            }, 200); // Increased delay to ensure bootstrap-notifications is loaded
        });
    </script>
    
    <!-- Cache Manager -->
    <script src="~/js/core/cache-manager.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => {
                        console.log('Service Worker registered', reg);
                        
                        // Detect Auth Change to clear stale page cache
                        const currentUserId = '@(User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : "guest")';
                        const lastUserId = localStorage.getItem('last_user_id');
                        
                        if (lastUserId && lastUserId !== currentUserId) {
                            console.log('Auth state changed, clearing page cache...');
                            if (window.CacheManager) {
                                window.CacheManager.clearPageCache();
                            }
                        }
                        localStorage.setItem('last_user_id', currentUserId);
                    })
                    .catch(err => console.log('Service Worker registration failed', err));
            });
        }
    </script>
</body>
</html>

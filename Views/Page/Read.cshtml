@model paradaya_lentera.Models.ViewModels.BookDetailViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Baca buku @Model.Title karya @Model.Author di Lentera. Nikmati pengalaman membaca digital yang nyaman." />
    <title>Membaca: @Model.Title - Lentera</title>
    <meta name="theme-color" content="#2196f3">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/images/pwa-icon-512.png">
    
    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://archive.org">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Use Local FontAwesome for consistency -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <!-- Bootstrap Icons for UI icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/pages/read.css" asp-append-version="true" />
</head>
<body>
    <div class="read-wrapper">
        <header class="read-header" id="mainHeader">
            <div class="header-left">
                <a href="javascript:history.back()" class="back-btn" id="btnBack">
                    <i class="bi bi-arrow-left"></i> <span>Kembali</span>
                </a>
                <div class="book-info-top">
                    <h1 id="bookTitle">@Model.Title</h1>
                    <p id="bookAuthor">@Model.Author</p>
                </div>
            </div>
            <div class="header-right">
                <a href="https://archive.org/download/@Model.IaId" 
                   target="_blank" 
                   rel="noopener noreferrer"
                   class="action-icon-btn" 
                   title="Download Buku" 
                   id="btnDownload"
                   data-iaid="@Model.IaId">
                    <i class="bi bi-download"></i>
                </a>
                <a asp-controller="Page" asp-action="Detail" 
                   asp-route-id="@Model.LocalBookId" 
                   asp-route-isbn="@Model.Isbn" 
                   asp-route-olkey="@Model.OlKey" 
                   class="action-icon-btn" title="Informasi Buku" id="btnInfo">
                    <i class="bi bi-info-circle"></i>
                </a>
                <button onclick="toggleFullscreen()" class="action-icon-btn" title="Layar Penuh" id="btnFullscreen">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
            </div>
        </header>

        <main class="viewer-container">
            <div id="loadingOverlay" class="loading-overlay">
                <div class="spinner"></div>
                <p>Mempersiapkan buku terbaik untuk Anda...</p>
            </div>
            
            <iframe id="bookViewer" 
                    src="https://archive.org/embed/@Model.IaId?ui=full" 
                    frameborder="0" 
                    webkitallowfullscreen="true" 
                    mozallowfullscreen="true" 
                    allowfullscreen 
                    loading="lazy"
                    title="Buku: @Model.Title"
                    onload="hideLoading()">
            </iframe>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/pages/read.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registered', reg))
                    .catch(err => console.log('Service Worker registration failed', err));
            });
        }
    </script>
</body>
</html>

@{
    ViewData["Title"] = "Test Icons";
}

<div class="container mt-4">
    <h1>Icon Test Page</h1>
    <p>This page tests Font Awesome icons and fallbacks.</p>
    
    <div class="row">
        <div class="col-md-6">
            <h3>Reading List Icons</h3>
            <div class="d-flex flex-wrap gap-3 mb-3">
                <button class="btn btn-primary">
                    <i class="fas fa-book-open"></i> Read Now
                </button>
                <button class="btn btn-success">
                    <i class="fas fa-check-circle"></i> Completed
                </button>
                <button class="btn btn-outline-secondary">
                    <i class="far fa-circle"></i> Unread
                </button>
                <button class="btn btn-danger">
                    <i class="fas fa-heart"></i> Favorite
                </button>
                <button class="btn btn-warning">
                    <i class="fas fa-times"></i> Remove
                </button>
                <button class="btn btn-info">
                    <i class="fas fa-cloud-download-alt"></i> Offline
                </button>
            </div>
        </div>
        
        <div class="col-md-6">
            <h3>Other Icons</h3>
            <div class="d-flex flex-wrap gap-3 mb-3">
                <button class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add
                </button>
                <button class="btn btn-secondary">
                    <i class="fas fa-search"></i> Search
                </button>
                <button class="btn btn-warning">
                    <i class="fas fa-star"></i> Star
                </button>
                <button class="btn btn-info">
                    <i class="fas fa-bookmark"></i> Bookmark
                </button>
            </div>
        </div>
    </div>
    
    <div class="mt-4">
        <h3>Debug Information</h3>
        <div id="debug-info" class="alert alert-info">
            <p><strong>Font Awesome Status:</strong> <span id="fa-status">Checking...</span></p>
            <p><strong>Fallback Applied:</strong> <span id="fallback-status">No</span></p>
        </div>
        
        <button class="btn btn-secondary" onclick="testFallback()">Force Apply Fallback</button>
        <button class="btn btn-primary" onclick="checkStatus()">Check Status</button>
    </div>
</div>

<script>
function checkStatus() {
    const faLoaded = window.checkFontAwesome ? window.checkFontAwesome() : false;
    const fallbackApplied = document.body.classList.contains('fontawesome-fallback');
    
    document.getElementById('fa-status').textContent = faLoaded ? 'Loaded' : 'Not Loaded';
    document.getElementById('fallback-status').textContent = fallbackApplied ? 'Yes' : 'No';
}

function testFallback() {
    if (window.applyFontAwesomeFallback) {
        window.applyFontAwesomeFallback();
        checkStatus();
    }
}

// Check status on page load
setTimeout(checkStatus, 1000);
</script>
@model paradaya_lentera.Models.ViewModels.ReadingListPagedViewModel
@{
    ViewData["Title"] = "Daftar Bacaan Saya";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/reading-list.css">
}

<div class="reading-list-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Daftar Bacaan Saya</h1>
        <p class="page-subtitle">Kelola perpustakaan pribadi dan progres membaca Anda.</p>
    </div>

    <!-- Filters and Actions -->
    <div class="reading-list-header">
        <div class="tab-buttons">
            <button class="tab-btn active" data-status="all">Semua</button>
            <button class="tab-btn" data-status="Favorite">Favorit</button>
            <button class="tab-btn" data-status="Read">Sudah Dibaca</button>
            <button class="tab-btn" data-status="Unread">Belum Dibaca</button>
        </div>
    </div>

    <!-- Books Grid -->
    <div class="books-grid" id="readingListGrid">
@foreach (var item in Model.Items)
{
    <div class="book-card"
     data-favorite="@item.IsFavorite.ToString().ToLower()"
     data-read="@item.IsRead.ToString().ToLower()"
     data-book-id="@item.BookId">

        <div class="book-cover-wrapper" onclick="viewBookDetail(@item.BookId)">
            <img src="@item.Book.Thumbnail"
                 alt="@item.Book.Title"
                 class="book-cover"
                 loading="lazy"
                 onload="handleImageLoad(this)"
                 onerror="handleImageTimeout(this)">
            @if (item.IsRead)
            {
                <div class="offline-badge" style="background: var(--accent-green);">SUDAH DIBACA</div>
            }
        </div>

        <div class="book-info">
            <div class="book-category">@((item.Book.Category ?? "GENERAL").ToUpper())</div>

            <h3 class="book-title" onclick="viewBookDetail(@item.BookId)">@item.Book.Title</h3>
            <p class="book-author">@item.Book.Author @if(item.Book.PublishedYear.HasValue){<text> • @item.Book.PublishedYear</text>}</p>
            
            <p class="book-description">
                @(item.Book.PublishedYear.HasValue ? $"Diterbitkan tahun {item.Book.PublishedYear}" : "Tahun terbit tidak diketahui")@if(item.Book.PageCount.HasValue){<text>, @item.Book.PageCount halaman</text>}
            </p>
            
            <div class="reading-list-primary-action">
                <a asp-controller="Page" asp-action="Read" asp-route-id="@item.BookId" class="btn-read-full">
                    BACA SEKARANG
                </a>
            </div>

            <!-- Secondary Actions -->
            <div class="reading-list-actions">
                <button class="btn-read-status @(item.IsRead ? "active" : "")" onclick="toggleRead(@item.Id, event)" title="@(item.IsRead ? "Tandai Belum Dibaca" : "Tandai Sudah Dibaca")">
                    <i class="@(item.IsRead ? "bi bi-check-circle-fill" : "bi bi-circle")"></i>
                </button>

                <button class="btn-favorite @(item.IsFavorite ? "active" : "")" onclick="toggleFavorite(@item.Id, event)" title="@(item.IsFavorite ? "Favorit" : "Tambah ke Favorit")">
                    <i class="@(item.IsFavorite ? "bi bi-heart-fill" : "bi bi-heart")"></i>
                </button>

                <button class="btn-remove" onclick="removeFromReadingList(@item.Id, event)" title="Hapus">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
    </div>
}
</div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-wrapper">
            @if (Model.HasPreviousPage)
            {
                <a href="@Url.Action("ReadingList", new { page = Model.CurrentPage - 1 })" style="text-decoration: none;">
                    <button type="button">
                        <span class="pagination-arrow">←</span>
                        <span class="pagination-label">Prev</span>
                    </button>
                </a>
            }
            else
            {
                <button type="button" disabled>
                    <span class="pagination-arrow">←</span>
                    <span class="pagination-label">Prev</span>
                </button>
            }

            <span id="pageInfo">Page @Model.CurrentPage of @Model.TotalPages</span>

            @if (Model.HasNextPage)
            {
                <a href="@Url.Action("ReadingList", new { page = Model.CurrentPage + 1 })" style="text-decoration: none;">
                    <button type="button">
                        <span class="pagination-label">Next</span>
                        <span class="pagination-arrow">→</span>
                    </button>
                </a>
            }
            else
            {
                <button type="button" disabled>
                    <span class="pagination-label">Next</span>
                    <span class="pagination-arrow">→</span>
                </button>
            }
        </div>
    }

    <!-- Empty State -->
    <div class="empty-state" id="emptyState" style="@(Model.Items.Any() ? "display: none;" : "display: block;")">
        <div class="empty-state-icon">📚</div>
        <h2 class="empty-state-title">Daftar bacaan kosong</h2>
        <p class="empty-state-text">Mulai tambahkan buku favorit Anda dari halaman pencarian</p>
        <button class="btn-add-book" onclick="window.location.href='/'">
            <i class="bi bi-plus"></i> Cari Buku Online
        </button>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="empty-state text-center py-5" style="display: none;">
        <div class="empty-icon mb-3">
            <i class="bi bi-book fa-3x text-muted"></i>
        </div>
        <h3 class="text-muted">Daftar Bacaan Kosong</h3>
        <p class="text-muted mb-4">
            Belum ada buku dalam daftar bacaan Anda.<br>
            Mulai tambahkan buku favorit untuk dibaca nanti.
        </p>
        <a asp-controller="Search" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search"></i> Cari Buku
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/reading-list.js"></script>
}